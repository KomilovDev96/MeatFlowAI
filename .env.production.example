# Copy to ".env" in the same directory as docker-compose.prod.yml on the SERVER.
# This file is never committed — create it manually once on the VPS.

# --- postgres ---
POSTGRES_DB=meatflow
POSTGRES_USER=meatflow
POSTGRES_PASSWORD=change-me-strong-password

# --- minio ---
MINIO_ROOT_USER=meatflow
MINIO_ROOT_PASSWORD=change-me-strong-password

# --- backend runtime (loaded via env_file by the backend service) ---
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://meatflow:change-me-strong-password@postgres:5432/meatflow?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=meatflow
MINIO_SECRET_KEY=change-me-strong-password
MINIO_BUCKET=meatflow
TELEGRAM_BOT_TOKEN=
# Must be HTTPS — Telegram rejects http:// for Mini App / web_app buttons.
TELEGRAM_WEBAPP_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example,https://www.your-domain.example

# --- deploy ---
# Which image tag docker-compose.prod.yml pulls; the deploy workflow overrides
# this to the commit SHA on every run, so "latest" here is just a local default.
IMAGE_TAG=latest
