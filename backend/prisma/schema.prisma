generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProductUnit {
  KG
  PIECE
}

enum SaleType {
  CASH
  CONSIGNMENT
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Company {
  id              String      @id @default(uuid())
  name            String
  avatar          String?
  phone           String?
  address         String?
  description     String?
  currency        String      @default("UZS")
  measurementUnit ProductUnit @default(KG)
  latitude        Float?
  longitude       Float?
  status          Status      @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  users           User[]
  clients         Client[]
  products        Product[]
  sales           Sale[]
  payments        Payment[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id                           String    @id @default(uuid())
  role                         Role
  firstName                    String
  lastName                     String?
  login                        String    @unique
  passwordHash                 String
  phone                        String?
  avatar                       String?
  telegramId                   String?   @unique
  telegramUsername             String?
  telegramConnected            Boolean   @default(false)
  telegramConnectCode          String?   @unique
  telegramConnectCodeExpiresAt DateTime?
  status                       Status    @default(ACTIVE)
  companyId                    String?
  company                      Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  lastLoginAt                  DateTime?
  lastActivityAt               DateTime?
  sales                        Sale[]    @relation("SaleSoldBy")
  paymentsRecorded             Payment[] @relation("PaymentRecordedBy")

  @@index([companyId])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model Client {
  id                           String    @id @default(uuid())
  companyId                    String
  company                      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName                    String
  lastName                     String?
  phone                        String?
  phone2                       String?
  telegramId                   String?   @unique
  telegramUsername             String?
  telegramConnectCode          String?   @unique
  telegramConnectCodeExpiresAt DateTime?
  avatar                       String?
  status                       Status    @default(ACTIVE)
  notes                        String?
  login                        String?   @unique
  passwordHash                 String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  lastLoginAt                  DateTime?
  lastActivityAt               DateTime?
  sales                        Sale[]
  payments                     Payment[]

  @@index([companyId])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model Product {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  category      String?
  image         String?
  unit          ProductUnit @default(KG)
  purchasePrice Decimal     @default(0) @db.Decimal(12, 2)
  salePrice     Decimal     @default(0) @db.Decimal(12, 2)
  stock         Decimal     @default(0) @db.Decimal(12, 3)
  status        Status      @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  saleItems     SaleItem[]

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model Sale {
  id          String     @id @default(uuid())
  orderNumber Int        @unique @default(autoincrement())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items       SaleItem[]
  totalAmount Decimal    @default(0) @db.Decimal(14, 2)
  type        SaleType   @default(CASH)
  soldAt      DateTime   @default(now())
  paidAt      DateTime?
  soldById    String?
  soldBy      User?      @relation("SaleSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime   @default(now())

  @@index([companyId])
  @@index([clientId])
  @@index([createdAt])
}

model SaleItem {
  id             String  @id @default(uuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityPieces Decimal @db.Decimal(12, 3)
  quantityKg     Decimal @db.Decimal(12, 3)
  pricePerKg     Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(14, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(CASH)
  currency    String        @default("UZS")
  note        String?
  paidAt      DateTime      @default(now())
  createdById String?
  createdBy   User?         @relation("PaymentRecordedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([companyId])
  @@index([clientId])
  @@index([paidAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}
